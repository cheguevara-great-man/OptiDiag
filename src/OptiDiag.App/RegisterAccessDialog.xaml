<Window x:Class="OptiDiag.App.RegisterAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="寄存器读写"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="寄存器读写" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="地址" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="AddressText" Grid.Column="1" FontFamily="Consolas" />
                <TextBlock Grid.Row="1" Text="当前值" Foreground="{DynamicResource MutedTextBrush}" Margin="0,9,0,0" />
                <TextBlock x:Name="CurrentValueText" Grid.Row="1" Grid.Column="1"
                           FontFamily="Consolas" FontSize="18" Margin="0,7,0,0" />
                <TextBlock Grid.Row="2" Text="访问属性" Foreground="{DynamicResource MutedTextBrush}" Margin="0,9,0,0" />
                <TextBlock x:Name="AccessText" Grid.Row="2" Grid.Column="1" Margin="0,9,0,0" />
                <TextBlock Grid.Row="3" Text="风险等级" Foreground="{DynamicResource MutedTextBrush}" Margin="0,9,0,0" />
                <TextBlock x:Name="RiskText" Grid.Row="3" Grid.Column="1" Margin="0,9,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="写入值（HEX）" VerticalAlignment="Center" />
            <TextBox x:Name="NewValueBox"
                     Grid.Column="1"
                     FontFamily="Consolas"
                     FontSize="18"
                     MaxLength="4"
                     TextAlignment="Center"
                     TextChanged="NewValueBox_TextChanged" />
        </Grid>

        <CheckBox x:Name="WriteUnlockCheckBox"
                  Grid.Row="3"
                  Content="解锁本次写入（将发送真实 I²C 写事务）"
                  Margin="106,12,0,14"
                  Checked="WriteUnlockCheckBox_Changed"
                  Unchecked="WriteUnlockCheckBox_Changed" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="重新读取" Click="ReadButton_Click" />
            <Button x:Name="WriteButton"
                    Content="写入新值"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="False"
                    Click="WriteButton_Click" />
            <Button Content="取消" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
